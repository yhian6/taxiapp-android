<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_logo_circle"
            android:contentDescription="@string/app_logo"
            android:padding="22dp"
            android:src="@drawable/ic_taxiapp_logo" />

        <TextView
            android:id="@+id/appNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif"
            android:text="@string/app_name"
            android:textColor="@color/blue_deep"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/committeeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="@string/committee_name"
            android:textColor="@color/yellow_points"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/taglineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/splash_tagline"
            android:textColor="@color/white_85"
            android:textSize="15sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/routeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:background="@drawable/bg_route_pill"
        android:fontFamily="sans-serif"
        android:paddingStart="18dp"
        android:paddingTop="9dp"
        android:paddingEnd="18dp"
        android:paddingBottom="9dp"
        android:text="@string/main_route"
        android:textColor="#fff"
        android:textSize="14sp"
        android:textStyle="bold" />

</FrameLayout>

